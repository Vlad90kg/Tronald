@page "/market"
@using Tronald.Exceptions
@using Tronald.Models
@using Tronald.Services
@rendermode InteractiveServer
@inject IMarketDataService MarketData

<PageTitle>Markets · Tronald</PageTitle>

<span class="badge bg-dark mb-2">FRED · ST. LOUIS FED</span>
<h1 class="fw-bold">Market prices</h1>
<p class="text-muted">Daily closing prices from the Federal Reserve Bank of St. Louis.</p>

<div class="card-tronald row g-2 align-items-end mx-0 mb-3">
    <div class="col-md-4">
        <label class="stat-label">Market</label>
        <select class="form-select" @bind="_symbol">
            @foreach (var s in Enum.GetValues<MarketSymbol>())
            {
                <option value="@s">@s.DisplayName()</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="stat-label">From</label>
        <input type="date" class="form-control mono" @bind="_from" />
    </div>
    <div class="col-md-2">
        <label class="stat-label">To</label>
        <input type="date" class="form-control mono" @bind="_to" />
    </div>
    <div class="col-md-3">
        <div class="btn-group w-100">
            @foreach (var months in new[] { 1, 3, 6, 12 })
            {
                <button class="btn btn-light btn-sm mono" @onclick="() => SetPeriodAsync(months)">@(months == 12 ? "1Y" : $"{months}M")</button>
            }
        </div>
    </div>
    <div class="col-md-1">
        <button class="btn btn-danger w-100" @onclick="LoadAsync" disabled="@_loading">
            @(_loading ? "..." : "Load")
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center">
        <span>@_error</span>
        <button class="btn btn-sm btn-danger" @onclick="LoadAsync">Retry</button>
    </div>
}
else if (_prices is null)
{
    <div class="card-tronald text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="text-muted mt-3 mb-0">Loading prices...</p>
    </div>
}
else if (_prices.Count < 2)
{
    <p class="text-muted">Not enough prices for this period.</p>
}
else
{
    var first = _prices[0];
    var last = _prices[^1];
    var low = _prices.MinBy(p => p.Close)!;
    var high = _prices.MaxBy(p => p.Close)!;
    var periodChange = (last.Close - first.Close) / first.Close;
    var latestDay = _days[0];

    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card-tronald h-100">
                <div class="stat-label">Latest close</div>
                <div class="stat-value">@last.Close.ToString("N2")</div>
                <span class="@(latestDay.Change >= 0 ? "chip-up" : "chip-down")">@latestDay.ChangePercent.ToString("+0.00%;-0.00%") on the day</span>
                <div class="mono small text-muted mt-1">@last.Date.ToString("dd MMM yyyy")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-tronald h-100">
                <div class="stat-label">Period low</div>
                <div class="stat-value">@low.Close.ToString("N2")</div>
                <div class="mono small text-muted">@low.Date.ToString("dd MMM yyyy")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-tronald h-100">
                <div class="stat-label">Period high</div>
                <div class="stat-value">@high.Close.ToString("N2")</div>
                <div class="mono small text-muted">@high.Date.ToString("dd MMM yyyy")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-tronald h-100">
                <div class="stat-label">Change over period</div>
                <div class="stat-value @(periodChange >= 0 ? "text-success" : "text-danger")">@periodChange.ToString("+0.00%;-0.00%")</div>
                <div class="mono small text-muted">@((last.Close - first.Close).ToString("+#,##0.00;-#,##0.00")) since @first.Date.ToString("dd MMM")</div>
            </div>
        </div>
    </div>

    <div class="card-tronald p-0 overflow-hidden">
        <div class="px-3 py-2 bg-light d-flex justify-content-between align-items-center">
            <strong>Daily prices (last 30 trading days)</strong>
            <span class="badge text-bg-light mono">FRED: @_symbol.ToFredSeriesId()</span>
        </div>
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr class="stat-label">
                <th>Date</th><th class="text-end">Close</th><th class="text-end">Change</th><th class="text-end">Change %</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var d in _days.Take(30))
            {
                <tr>
                    <td class="mono">@d.Date.ToString("dd MMM yyyy")</td>
                    <td class="text-end mono fw-bold">@d.Close.ToString("N2")</td>
                    <td class="text-end mono @(d.Change >= 0 ? "text-success" : "text-danger")">@d.Change.ToString("+#,##0.00;-#,##0.00")</td>
                    <td class="text-end"><span class="@(d.Change >= 0 ? "chip-up" : "chip-down")">@d.ChangePercent.ToString("+0.00%;-0.00%")</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private record DayRow(DateOnly Date, decimal Close, decimal Change, decimal ChangePercent);

    private MarketSymbol _symbol = MarketSymbol.WtiOil;
    private DateOnly _to = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly _from = DateOnly.FromDateTime(DateTime.Today).AddMonths(-3);

    private IReadOnlyList<PricePoint>? _prices;
    private List<DayRow> _days = [];
    private string? _error;
    private bool _loading;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task SetPeriodAsync(int months)
    {
        _to = DateOnly.FromDateTime(DateTime.Today);
        _from = _to.AddMonths(-months);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _prices = await MarketData.GetPricesAsync(_symbol, _from, _to);
            _days = _prices
                .Zip(_prices.Skip(1), (prev, cur) => new DayRow(
                    cur.Date,
                    cur.Close,
                    cur.Close - prev.Close,
                    (cur.Close - prev.Close) / prev.Close))
                .OrderByDescending(d => d.Date)
                .ToList();
        }
        catch (Exception ex) when (ex is ApiException or ArgumentException)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}